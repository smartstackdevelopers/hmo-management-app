# Copy values into a local .env that is never committed.

# Web
NEXT_PUBLIC_APP_NAME=HMore
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
APP_NAME=HMore API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
REDIS_URL=redis://localhost:6379/0

# AI service
# OPENAI_API_KEY is unused in F1.1. Do not commit a real key.

# Postgres (compose only; schema is F1.2)
POSTGRES_DB=hmore
POSTGRES_USER=hmore
POSTGRES_PASSWORD=hmore
