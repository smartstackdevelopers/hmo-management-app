# Copy values into a local .env that is never committed.

# Web
NEXT_PUBLIC_APP_NAME=HMore
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
APP_NAME=HMore API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
REDIS_URL=redis://localhost:6379/0
# F2.2 reminder lead times (minutes). External delivery is F2.12 (log stub until then).
# REMINDER_SHIFT_LEAD_MINUTES=60
# REMINDER_VISIT_LEAD_MINUTES=120
# REMINDER_TASK_DUE_LEAD_MINUTES=1440
# REMINDER_DISPATCH_BATCH_SIZE=100
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI service
# OPENAI_API_KEY is unused in F1.1. Do not commit a real key.

# Auth0 (UK or EU tenant). Never commit real secrets.
# AUTH0_DOMAIN=your-tenant.uk.auth0.com
# AUTH0_AUDIENCE=https://api.hmore.local
# AUTH0_ISSUER=https://your-tenant.uk.auth0.com/
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=
# APP_BASE_URL=http://localhost:3000

# Postgres (local Compose / Docker pgvector image)
POSTGRES_DB=hmore
POSTGRES_USER=hmore
POSTGRES_PASSWORD=hmore
DATABASE_URL=postgresql+psycopg://hmore:hmore@localhost:5432/hmore
# TEST_DATABASE_URL=postgresql+psycopg://hmore:hmore@localhost:5432/hmore_test
