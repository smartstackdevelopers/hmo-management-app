# Production web (inject via ECS task secrets / Secrets Manager). Never commit real values.

NEXT_PUBLIC_APP_NAME=HMore
NEXT_PUBLIC_API_BASE_URL=https://api.example.hmore.uk

AUTH0_DOMAIN=your-tenant.uk.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=https://app.example.hmore.uk
AUTH0_AUDIENCE=https://api.hmore.uk

# Optional monitoring (no PII)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_DSN=  # only if client-side reporting approved
