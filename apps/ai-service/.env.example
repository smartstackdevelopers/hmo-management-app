APP_NAME=HMore AI Service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=info

# Required for protected gateway routes (core API → AI service).
# Generate a long random secret; never commit the real value.
AI_SERVICE_TOKEN=

# LLM_PROVIDER: none | mock | openai
# - none: no provider (workflows that need LLM will fail clearly)
# - mock: explicit test/dev mock only — never used as a silent fallback
# - openai: requires OPENAI_API_KEY
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

AI_MAX_REQUEST_BYTES=262144
AI_WORKFLOW_TIMEOUT_SECONDS=60
AI_DEFAULT_ALLOWED_FEATURES=ai.foundation,ai.workflow.execute,ai.prompts.read,ai.approvals
