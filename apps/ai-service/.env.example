APP_NAME=HMore AI Service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=info

AI_SERVICE_TOKEN=

LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# F3.2 routing
AI_DEFAULT_MODEL_KEY=default_low_cost
AI_PREMIUM_MODEL_ID=gpt-4o
# Optional JSON array of model configs; empty uses built-in low/premium entries.
AI_MODEL_REGISTRY_JSON=
AI_ESCALATION_ENABLED=true
AI_ESCALATION_MAX_ATTEMPTS=1
AI_ESCALATE_ON_EMPTY_OUTPUT=true
AI_ESCALATE_ON_VALIDATION_FAILURE=true

# F3.2 cache / Redis
REDIS_URL=redis://localhost:6379/0
AI_CACHE_ENABLED=true
AI_CACHE_BACKEND=memory
AI_CACHE_TTL_SECONDS=300
AI_CACHE_LOCK_TTL_SECONDS=30
AI_CACHE_FAIL_OPEN=true

# F3.2 batch
AI_BATCH_MAX_RETRIES=2
AI_BATCH_EAGER=true
AI_BATCH_FAIL_OPEN_TO_EAGER=true

AI_MAX_REQUEST_BYTES=262144
AI_WORKFLOW_TIMEOUT_SECONDS=60
AI_DEFAULT_ALLOWED_FEATURES=ai.foundation,ai.workflow.execute,ai.prompts.read,ai.approvals,ai.routing.read,ai.batch.submit,ai.batch.read

# F3.3 budget enforcement against core API
CORE_API_BASE_URL=http://localhost:8000
AI_BUDGET_HTTP_TIMEOUT_SECONDS=5
# Set false in production once CORE_API_BASE_URL and AI_SERVICE_TOKEN are configured.
AI_BUDGET_ENFORCEMENT_FAIL_OPEN=true
