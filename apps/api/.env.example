APP_NAME=HMore API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379/0
# F2.2 / F2.3 reminder lead times. External delivery is F2.12.
# REMINDER_SHIFT_LEAD_MINUTES=60
# REMINDER_VISIT_LEAD_MINUTES=120
# REMINDER_TASK_DUE_LEAD_MINUTES=1440
# REMINDER_TRAINING_EXPIRY_LEAD_DAYS=30
# REMINDER_SAFEGUARDING_LEAD_MINUTES=1440
# REMINDER_INCIDENT_FOLLOW_UP_LEAD_MINUTES=1440
# REMINDER_DISPATCH_BATCH_SIZE=100
# Comma-separated browser origins. Production must not use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# ENFORCE_HTTPS_ORIGINS=true

# PostgreSQL for the FastAPI schema. Do not point this at Room Ready SQLite.
DATABASE_URL=postgresql+psycopg://hmore:hmore@localhost:5432/hmore
# Optional isolated database for pytest. Defaults to DATABASE_URL when unset.
# TEST_DATABASE_URL=postgresql+psycopg://hmore:hmore@localhost:5432/hmore_test

# F3.3 — shared secret for AI service → core API budget/metering (must match AI service)
# AI_SERVICE_TOKEN=
# F3.4 — core API calls into the AI service
# AI_SERVICE_BASE_URL=http://localhost:8001
# AI_SERVICE_TIMEOUT_SECONDS=60
# NOTES_ANALYSIS_BATCH_CRON=0 2 * * *

# Auth0 (UK or EU tenant domain, no https://)
# AUTH0_DOMAIN=your-tenant.uk.auth0.com
# AUTH0_AUDIENCE=https://api.hmore.local
# AUTH0_ISSUER=https://your-tenant.uk.auth0.com/
# AUTH0_REQUIRE_MFA_CLAIM=false

# Private file storage (F1.8) — never commit real credentials
# Prefer IAM roles in AWS; leave access keys empty when using instance/task roles.
# STORAGE_PROVIDER=memory
# STORAGE_LOCAL_ROOT=.hmore-private-storage
# STORAGE_MAX_UPLOAD_BYTES=10485760
# STORAGE_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain
# S3_ENDPOINT_URL=
# S3_REGION=eu-west-2
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# F4.3 Expo push. Leave commented until a real token exists. Never commit the token.
# Default log records provider_not_configured and does not mark a delivery sent.
# EXPO_ACCESS_TOKEN=
# PUSH_ADAPTER_MODE=log

# F8.1 AI voice calling add-on (disabled until organisational approval)
# VOICE_CALLING_GLOBAL_ENABLED=false

# F8.2 Advanced safeguarding alerts add-on (disabled until organisational approval)
# SAFEGUARDING_ALERTS_GLOBAL_ENABLED=false

# F8.3 Rent & tenancy payments add-on (disabled until organisational approval)
# RENT_PAYMENTS_GLOBAL_ENABLED=false
# RENT_STRIPE_SECRET_KEY=
# RENT_PAYMENT_WEBHOOK_SIGNING_SECRET=

# F8.4 Training LMS add-on (disabled until organisational approval)
# LMS_GLOBAL_ENABLED=false
# CONTRACTOR_MARKETPLACE_GLOBAL_ENABLED=false
# DIGITAL_ID_ESIGN_GLOBAL_ENABLED=false
# DIGITAL_ID_ESIGN_WEBHOOK_SIGNING_SECRET=
# BENEFITS_NAVIGATOR_GLOBAL_ENABLED=false
# TENANT_ENGAGEMENT_GLOBAL_ENABLED=false
# INTEGRATION_HUB_GLOBAL_ENABLED=false

# Monitoring (F7.6) — optional until Sentry project exists
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
