# FastAPI (HMore). Public base including /api/v1.
# When unset, the app uses http://<dev-host>:8000/api/v1
# (Android emulator host 10.0.2.2, web localhost, otherwise the Expo dev host).
# EXPO_PUBLIC_HMORE_API_URL=http://localhost:8000/api/v1

# Auth0 Native application (UK or EU tenant). Public client — no client secret in the app.
# EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.uk.auth0.com
# EXPO_PUBLIC_AUTH0_CLIENT_ID=
# EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.hmore.local
# EXPO_PUBLIC_AUTH0_SCHEME=roomready

# Legacy Room Ready API (password login). Used only when Auth0 variables above are unset.
# EXPO_PUBLIC_API_URL=http://localhost:3001

# EAS project UUID for Expo push. Expo Go, or the placeholder project id in app.json, cannot deliver a device push.
# EXPO_PUBLIC_EAS_PROJECT_ID=
